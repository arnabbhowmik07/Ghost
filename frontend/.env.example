# PUBLIC BUILD-TIME - baked into the Next.js bundle at `next build`.
# Never put keypairs or secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RELAYER_URL=https://ghost-api.arnabbhowmik.in
NEXT_PUBLIC_PROGRAM_ID=69gepJRrDXGgaKExaUHWmDjtLe4LHxTrNiGVzBGoTczR
NEXT_PUBLIC_USDC_MINT=GLfrBSjkzFQZJrWEcWfA9j1yapabGYTwdcNJKAgqWeCt
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
# Empty = on for non-mainnet, off for mainnet-beta. Set true/false to force.
NEXT_PUBLIC_SHIELD_ENABLED=
# Reown AppKit / WalletConnect - https://dashboard.reown.com
# Public demo id only works on localhost; use your own for deploy.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RUNTIME (next start / Docker) - not baked into the client bundle
PORT=3000
HOST=0.0.0.0
